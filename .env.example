# Required once the token is live. Do not commit a real treasury keypair.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
TOKEN_MINT=replace_after_launch
TOKEN_PROGRAM=legacy

# Reflection funding policy: exactly 1% (100 basis points) of recorded creator
# rewards is swept to a separate payout treasury. Configure the creator-reward
# wallet used at launch only after it exists.
CREATOR_REWARD_ALLOCATION_BPS=100
CREATOR_REWARDS_ADDRESS=replace_after_launch
CREATOR_REWARDS_KEYPAIR_PATH=secrets/creator-rewards.json
REFLECTION_TREASURY_ADDRESS=replace_after_launch

# Holder eligibility
MIN_ELIGIBLE_TOKENS=1000
EXCLUDED_WALLETS=
MAX_RECIPIENTS=2000

# Local, development-only reflection treasury signer path. Production should use
# a KMS/HSM or a dedicated remote signer adapter.
TREASURY_KEYPAIR_PATH=secrets/treasury.json
REFLECTIONS_BROADCAST_ENABLED=false

# Public reporting API
PORT=3000
DATA_DIR=data
