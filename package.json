{
  "name": "solana-reflection-infra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "description": "Safe operational infrastructure for SOL holder-reflection campaigns.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "preview:site": "node scripts/preview-site.mjs",
    "snapshot": "tsx src/cli.ts snapshot",
    "fund": "tsx src/cli.ts fund",
    "plan": "tsx src/cli.ts plan",
    "execute": "tsx src/cli.ts execute",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^16.6.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  }
}
